@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:     <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix time:   <http://www.w3.org/2006/time#> .

# Ontology Namespaces
@prefix sro:    <https://www.knoid.io/ontologies/sro#> .
@prefix pm:     <https://www.knoid.io/ontologies/pm#> .
@prefix spo:    <https://www.knoid.io/ontologies/spo#> .
@prefix eo:     <https://www.knoid.io/ontologies/eo#> .
@prefix rsro:   <https://www.knoid.io/ontologies/rsro#> .

########################################################################
# CORE CLASSES
########################################################################

sro:UserStory a owl:Class ;
    rdfs:label "User Story"@en ;
    rdfs:comment "A requirement expressed from the user's perspective"@en .

sro:Epic a owl:Class ;
    rdfs:subClassOf sro:UserStory ;
    rdfs:label "Epic"@en ;
    rdfs:comment "A large user story that can be decomposed into smaller ones"@en .

pm:Task a owl:Class ;
    rdfs:label "Project Task"@en ;
    rdfs:comment "A unit of scheduled work within a project"@en ;
    rdfs:subClassOf time:ProperInterval .

spo:Project rdfs:subClassOf time:ProperInterval .

pm:Dependency a owl:Class ;
    rdfs:label "Dependency"@en ;
    rdfs:comment "A precedence relationship between two tasks"@en .

########################################################################
# OBJECT PROPERTIES
########################################################################

sro:decomposedInto a owl:ObjectProperty ;
    rdfs:label "decomposed into"@en ;
    rdfs:domain sro:Epic ;
    rdfs:range sro:UserStory ;
    rdfs:comment "Relates an epic to the user stories it is decomposed into"@en .

pm:predecessor a owl:ObjectProperty ;
    rdfs:label "predecessor task"@en ;
    rdfs:domain pm:Dependency ;
    rdfs:range pm:Task ;
    rdfs:comment "The task that must complete before the successor can proceed"@en .

pm:successor a owl:ObjectProperty ;
    rdfs:label "successor task"@en ;
    rdfs:domain pm:Dependency ;
    rdfs:range pm:Task ;
    rdfs:comment "The task that follows in a dependency relationship"@en .

pm:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on"@en ;
    rdfs:domain pm:Task ;
    rdfs:range pm:Task ;
    rdfs:comment "Indicates that one task depends on another"@en ;
    owl:inverseOf pm:precedes .

pm:precedes a owl:ObjectProperty ;
    rdfs:label "precedes"@en ;
    rdfs:domain pm:Task ;
    rdfs:range pm:Task ;
    rdfs:comment "Indicates that one task must precede another"@en ;
    owl:inverseOf pm:dependsOn .


pm:DependencyType a owl:Class ;
    rdfs:subClassOf eo:Endurant ;
    rdfs:label "Dependency Type"@en ;
    rdfs:comment "The type of dependency relationship"@en ;
    owl:oneOf (
        pm:FinishToStart
        pm:StartToStart
        pm:FinishToFinish
        pm:StartToFinish
    ) .

# Dependency Type Instances
pm:FinishToStart a pm:DependencyType ;
    rdfs:label "Finish to Start"@en ;
    skos:definition "Successor cannot start until predecessor finishes"@en .

pm:StartToStart a pm:DependencyType ;
    rdfs:label "Start to Start"@en ;
    skos:definition "Successor cannot start until predecessor starts"@en .

pm:FinishToFinish a pm:DependencyType ;
    rdfs:label "Finish to Finish"@en ;
    skos:definition "Successor cannot finish until predecessor finishes"@en .

pm:StartToFinish a pm:DependencyType ;
    rdfs:label "Start to Finish"@en ;
    skos:definition "Successor cannot finish until predecessor starts"@en .
########################################################################
# DATATYPE PROPERTIES
########################################################################

pm:estimatedEffortDays a owl:DatatypeProperty ;
    rdfs:label "estimated effort (days)"@en ;
    rdfs:domain pm:Task ;
    rdfs:range xsd:integer .

########################################################################
# HELPER AXIOMS
########################################################################

pm:dependsOn a owl:TransitiveProperty .
pm:precedes a owl:TransitiveProperty .
pm:dependsOn a owl:AsymmetricProperty .
pm:precedes a owl:AsymmetricProperty .

