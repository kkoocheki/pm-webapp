## Temporal Properties (Generic)

spo:startDate a owl:DatatypeProperty ;
    rdfs:label "start date"@en ;
    rdfs:domain eo:Perdurant ;
    rdfs:range xsd:date ;
    rdfs:comment "The date when something starts"@en .

spo:endDate a owl:DatatypeProperty ;
    rdfs:label "end date"@en ;
    rdfs:domain eo:Perdurant ;
    rdfs:range xsd:date ;
    rdfs:comment "The date when something ends"@en .

