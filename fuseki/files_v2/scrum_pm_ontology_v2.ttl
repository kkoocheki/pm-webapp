## PM Temporal Properties

pm:startDate a owl:DatatypeProperty ;
    rdfs:label "start date (PM)"@en ;
    rdfs:subPropertyOf spo:startDate ;
    rdfs:domain pm:Activity ;
    rdfs:range xsd:date ;
    rdfs:comment "Activity start date"@en .

pm:finishDate a owl:DatatypeProperty ;
    rdfs:label "finish date"@en ;
    rdfs:subPropertyOf spo:endDate ;
    rdfs:domain pm:Activity ;
    rdfs:range xsd:date ;
    rdfs:comment "Activity finish date"@en .

pm:endDate a owl:DatatypeProperty ;
    rdfs:label "end date"@en ;
    rdfs:subPropertyOf spo:endDate ;
    rdfs:domain pm:Task ;
    rdfs:range xsd:date ;
    rdfs:comment "The end/finish date of the task"@en .

pm:hasPlannedStart a owl:DatatypeProperty ;
    rdfs:label "planned start date"@en ;
    rdfs:subPropertyOf pm:startDate ;
    rdfs:domain [ owl:unionOf (pm:Activity sro:Sprint sro:ScrumProject sro:UserStory sro:Epic) ] ;
    rdfs:range xsd:date ;
    rdfs:comment "The planned start date of a work item"@en .

pm:hasPlannedEnd a owl:DatatypeProperty ;
    rdfs:label "planned end date"@en ;
    rdfs:subPropertyOf pm:finishDate ;
    rdfs:domain [ owl:unionOf (pm:Activity sro:Sprint sro:ScrumProject sro:UserStory sro:Epic) ] ;
    rdfs:range xsd:date ;
    rdfs:comment "The planned end date of a work item"@en .

pm:hasActualStart a owl:DatatypeProperty ;
    rdfs:label "actual start date"@en ;
    rdfs:subPropertyOf pm:startDate ;
    rdfs:domain [ owl:unionOf (pm:Activity sro:Sprint sro:UserStory) ] ;
    rdfs:range xsd:date ;
    rdfs:comment "The actual start date of a work item"@en .

pm:hasActualEnd a owl:DatatypeProperty ;
    rdfs:label "actual end date"@en ;
    rdfs:subPropertyOf pm:finishDate ;
    rdfs:domain [ owl:unionOf (pm:Activity sro:Sprint sro:UserStory) ] ;
    rdfs:range xsd:date ;
    rdfs:comment "The actual end date of a work item"@en .

pm:lagDuration a owl:DatatypeProperty ;
    rdfs:label "lag duration"@en ;
    rdfs:subPropertyOf spo:duration ;
    rdfs:domain pm:Dependency ;
    rdfs:range xsd:duration ;
    rdfs:comment "Time lag in a dependency"@en .

