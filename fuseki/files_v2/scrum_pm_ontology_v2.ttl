## Critical Path Method Properties

pm:duration a owl:DatatypeProperty ;
    rdfs:label "duration (days)"@en ;
    rdfs:domain pm:Task ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The duration of a task in working days"@en .

pm:plannedDuration a owl:DatatypeProperty ;
    rdfs:label "planned duration"@en ;
    rdfs:domain pm:Task ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The planned duration of a task in working days"@en .

pm:earliestStart a owl:DatatypeProperty ;
    rdfs:label "earliest start"@en ;
    rdfs:domain pm:Task ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Earliest start time in days from project start (forward pass)"@en ;
    skos:definition "The earliest time a task can start without violating dependencies"@en .

pm:earliestFinish a owl:DatatypeProperty ;
    rdfs:label "earliest finish"@en ;
    rdfs:domain pm:Task ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Earliest finish time in days from project start"@en .

pm:latestStart a owl:DatatypeProperty ;
    rdfs:label "latest start"@en ;
    rdfs:domain pm:Task ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Latest start time without delaying project (backward pass)"@en ;
    skos:definition "The latest time a task can start without delaying the project"@en .

pm:latestFinish a owl:DatatypeProperty ;
    rdfs:label "latest finish"@en ;
    rdfs:domain pm:Task ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Latest finish time without delaying project"@en .

pm:totalFloat a owl:DatatypeProperty ;
    rdfs:label "total float"@en ;
    rdfs:domain pm:Task ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Total slack time available (LS - ES or LF - EF)"@en ;
    skos:definition "The amount of time a task can be delayed without delaying the project"@en .

pm:freeFloat a owl:DatatypeProperty ;
    rdfs:label "free float"@en ;
    rdfs:domain pm:Task ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Slack time without delaying any successor task"@en .

pm:isCritical a owl:DatatypeProperty ;
    rdfs:label "is critical"@en ;
    rdfs:domain pm:Task ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether the task is on the critical path (zero total float)"@en .

pm:lag a owl:DatatypeProperty ;
    rdfs:label "lag"@en ;
    rdfs:domain pm:Dependency ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Time delay between predecessor and successor in days"@en .

pm:lead a owl:DatatypeProperty ;
    rdfs:label "lead"@en ;
    rdfs:domain pm:Dependency ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Negative lag (overlap) between predecessor and successor"@en .

pm:weight a owl:DatatypeProperty ;
    rdfs:label "weight"@en ;
    rdfs:domain pm:Dependency ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Calculated weight for longest path algorithm based on dependency type"@en ;
    skos:definition "Weight used in DAG longest path calculation (Neo4j GDS style)"@en .

pm:projectDuration a owl:DatatypeProperty ;
    rdfs:label "project duration"@en ;
    rdfs:domain pm:CriticalPathAnalysis ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Total project duration determined by the critical path"@en .

pm:pathLength a owl:DatatypeProperty ;
    rdfs:label "path length"@en ;
    rdfs:domain pm:CriticalPath ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Total length of the critical path in days"@en .

pm:calculationMethod a owl:DatatypeProperty ;
    rdfs:label "calculation method"@en ;
    rdfs:domain pm:CriticalPathAnalysis ;
    rdfs:range xsd:string ;
    rdfs:comment "The algorithm used for CPM calculation"@en .

pm:analysisDate a owl:DatatypeProperty ;
    rdfs:label "analysis date"@en ;
    rdfs:domain pm:CriticalPathAnalysis ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "When the critical path analysis was performed"@en .

pm:dependencyTypeCode a owl:DatatypeProperty ;
    rdfs:label "dependency type code"@en ;
    rdfs:domain pm:DependencyType ;
    rdfs:range xsd:string ;
    rdfs:comment "Short code for dependency type (FS, SS, FF, SF)"@en .

# ============================================================================
# AXIOMS AND CONSTRAINTS FOR REASONING
# ============================================================================

## Disjoint Classes

[] a owl:AllDisjointClasses ;
    owl:members (sro:ProductOwner sro:ScrumMaster sro:Developer) .

[] a owl:AllDisjointClasses ;
    owl:members (sro:PlanningMeeting sro:DailyStandupMeeting sro:ReviewMeeting sro:RetrospectiveMeeting) .

## Cardinality Constraints

sro:ScrumProject rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty sro:hasProductBacklog ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass sro:ProductBacklog
] .

sro:Sprint rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty sro:hasSprintBacklog ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass sro:SprintBacklog
] .

sro:ScrumTeam rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty eo:hasTeamMember ;
    owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
    owl:onClass sro:ScrumTeamMember ;
    rdfs:comment "A Scrum team must have at least 3 members (PO, SM, Dev)"@en
] .

## Property Chains for Transitive Reasoning

# If A is part of B, and B is part of C, then A is part of C
spo:partOf a owl:TransitiveProperty .

# If Epic E is decomposed into Story S, and S materializes Deliverable D, 
# then D materializes E
[] a owl:Axiom ;
    owl:annotatedSource sro:materializes ;
    owl:annotatedProperty owl:propertyChainAxiom ;
    owl:annotatedTarget (sro:materializes [ owl:inverseOf sro:decomposedInto ]) .

## Inverse Properties
spo:composedOf owl:inverseOf spo:partOf .
spo:hasStakeholder owl:inverseOf spo:interestedIn .
pm:precedes owl:inverseOf pm:dependsOn .
pm:predecessor owl:inverseOf pm:successor .

## Functional Properties
sro:hasProductBacklog a owl:FunctionalProperty .
sro:hasSprintBacklog a owl:FunctionalProperty .

# ============================================================================
# REASONING RULES - CLASS INFERENCE (OWL)
# ============================================================================

## Rule: Accepted Deliverable Classification
sro:AcceptedDeliverable owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        sro:Deliverable
        [
            a owl:Restriction ;
            owl:onProperty sro:isAccepted ;
            owl:hasValue true
        ]
    )
] .

## Rule: Critical Task Classification  
pm:CriticalTask owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        pm:Task
        [
            a owl:Restriction ;
            owl:onProperty pm:totalFloat ;
            owl:hasValue "0"^^xsd:decimal
        ]
    )
] .

## Rule: Critical Dependency Classification
pm:CriticalDependency owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        pm:Dependency
        [
            a owl:Restriction ;
            owl:onProperty pm:source ;
            owl:someValuesFrom pm:CriticalTask
        ]
        [
            a owl:Restriction ;
            owl:onProperty pm:target ;
            owl:someValuesFrom pm:CriticalTask
        ]
    )
] .

## Rule: Milestone Classification
pm:Milestone owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        pm:Task
        [
            a owl:Restriction ;
            owl:onProperty pm:duration ;
            owl:hasValue "0"^^xsd:decimal
        ]
    )
] .

## Rule: Successfully Performed Task Classification
sro:SuccessfullyPerformedScrumDevelopmentTask owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        sro:PerformedScrumDevelopmentTask
        [
            a owl:Restriction ;
            owl:onProperty sro:produces ;
            owl:allValuesFrom sro:AcceptedDeliverable
        ]
    )
] .

## Rule: Complex Project Classification
sro:ScrumComplexProject owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        sro:ScrumProject
        [
            a owl:Restriction ;
            owl:onProperty sro:hasSubProject ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger
        ]
    )
] .

## Rule: Done User Story
[] a owl:Class ;
   rdfs:subClassOf sro:UserStory ;
   owl:equivalentClass [
       a owl:Restriction ;
       owl:onProperty [ owl:inverseOf sro:materializes ] ;
       owl:someValuesFrom sro:AcceptedDeliverable
   ] ;
   rdfs:subClassOf [
       a owl:Restriction ;
       owl:onProperty sro:isDone ;
       owl:hasValue true
   ] .

# ============================================================================
# PROPERTY CHARACTERISTICS FOR REASONING
# ============================================================================

## Transitive Properties
spo:partOf a owl:TransitiveProperty .
pm:hasParent a owl:TransitiveProperty .
spo:dependsOn a owl:TransitiveProperty .
sro:decomposedInto a owl:TransitiveProperty .

## Irreflexive Properties
spo:dependsOn a owl:IrreflexiveProperty .
pm:precedes a owl:IrreflexiveProperty .
sro:decomposedInto a owl:IrreflexiveProperty .

## Asymmetric Properties
pm:hasParent a owl:AsymmetricProperty .
spo:dependsOn a owl:AsymmetricProperty .

# ============================================================================
# END OF SCRUM PM ONTOLOGY v2.0.0
# ============================================================================
