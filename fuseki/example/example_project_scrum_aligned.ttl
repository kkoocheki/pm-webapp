    rdfs:label "Build tour steps"@en ;
    pm:taskDescription "Create interactive tour component with step definitions" ;
    pm:hasPlannedStart "2025-11-10"^^xsd:date ;
    pm:hasPlannedEnd "2025-11-14"^^xsd:date ;
