# --- Story S5 Tasks (Chart Components) ---

ex:T11 a pm:Task ;
    rdfs:label "Build LineChart"@en ;
    pm:taskDescription "Create reusable line chart component" ;
    pm:hasPlannedStart "2025-11-08"^^xsd:date ;
    pm:hasPlannedEnd "2025-11-13"^^xsd:date ;
